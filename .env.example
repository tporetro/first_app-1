# Storm Lead Pipeline — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Core AI ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx   # Claude API — email composition + prospect research

# ── Contact Enrichment ────────────────────────────────────────────────────────
CLAY_API_KEY=clay_xxxxxxxxxx           # Clay.com — primary enrichment (50+ providers)

# ── Report Generation ─────────────────────────────────────────────────────────
GAMMA_API_KEY=sk-gamma-xxxxxxxxxx      # Gamma API — presentation generation

# ── Email Delivery ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxx           # Resend — transactional email + webhooks

# ── CRM ──────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na-xxxxxxxxxx # HubSpot private app token

# ── Notifications ─────────────────────────────────────────────────────────────
PUSHOVER_API_TOKEN=xxxxxxxxxx          # Pushover app token
PUSHOVER_USER_KEY=xxxxxxxxxx           # Pushover user/group key

# ── Background Jobs ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0     # Sidekiq job queue + variant optimizer cache

# ── Cron Schedule Reference ───────────────────────────────────────────────────
# Storm monitor:  */15 * * * *  (every 15 min — first-mover detection)
# Amy follow-ups: 0 15 * * *    (9 AM CST = 15:00 UTC daily)
# Variant scorer: 0 * * * *     (hourly — Thompson Sampling updates)
