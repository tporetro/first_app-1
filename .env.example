# Storm Lead Pipeline — Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Dashboard authentication ──────────────────────────────────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme-use-a-strong-password

# ── Core AI ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxx   # Claude — email composition, research, vision

# ── Contact Enrichment ────────────────────────────────────────────────────────
CLAY_API_KEY=clay_xxxxxxxxxx          # Clay.com — primary enrichment (50+ providers)
APOLLO_API_KEY=xxxxxxxxxx             # Apollo.io — enrichment fallback

# ── Report Generation ─────────────────────────────────────────────────────────
GAMMA_API_KEY=sk-gamma-xxxxxxxxxx     # Gamma API — presentation generation

# ── Email Delivery ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxx          # Resend — transactional email sends
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxx # Resend — webhook HMAC signing secret
# Resend domain: verify mail.rgcroof.com (SPF + DKIM). FROM = michael@mail.rgcroof.com,
# REPLY_TO = michael@rgcroof.com. DMARC on rgcroof.com root: v=DMARC1; p=quarantine
# Inbound routing: amy@rgcroof.com + michael@rgcroof.com → /webhooks/resend/inbound

# ── Follow-up CTA ─────────────────────────────────────────────────────────────
CALENDLY_URL=https://calendly.com/restorationgc/20min  # Booking link in Day 7+ follow-ups

# ── CRM ───────────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=pat-na-xxxxxxxxxx # HubSpot private app token (optional)

# ── Notifications ─────────────────────────────────────────────────────────────
PUSHOVER_API_TOKEN=xxxxxxxxxx         # Pushover app token
PUSHOVER_USER_KEY=xxxxxxxxxx          # Pushover user/group key

# ── Background Jobs ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0    # Sidekiq + variant optimizer cache

# ── Rails ─────────────────────────────────────────────────────────────────────
RAILS_ENV=production
SECRET_KEY_BASE=run-bin/rails-secret-to-generate

# ── Cron Schedule Reference ───────────────────────────────────────────────────
# Storm monitor:  */15 * * * *  (every 15 min — NOAA first-mover detection)
# Amy follow-ups: 0 15 * * *    (9 AM CST = 15:00 UTC daily)
# Variant scorer: 0 * * * *     (hourly — Thompson Sampling failure scoring)
