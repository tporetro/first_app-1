# Kalshi API (only needed for live buying-power lookup / orders). Use the DEMO env first.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=./kalshi_private_key.pem
# demo = https://demo-api.kalshi.co/trade-api/v2 ; prod = https://api.elections.kalshi.com/trade-api/v2
KALSHI_BASE_URL=https://demo-api.kalshi.co/trade-api/v2
# Live trading needs BOTH --live on the CLI and this set to YES_SEND_REAL_ORDERS
KALSHI_LIVE_CONFIRM=
